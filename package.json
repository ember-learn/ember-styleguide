{
  "name": "ember-styleguide",
  "version": "11.4.0",
  "description": "Addon to help standardize the ember family of websites",
  "keywords": [
    "ember-addon"
  ],
  "type": "module",
  "homepage": "https://ember-styleguide.netlify.app/",
  "repository": "https://github.com/ember-learn/ember-styleguide.git",
  "license": "MIT",
  "contributors": [
    "Sivakumar Kailasam <siva@rubberduck.engineering>",
    "Ember.JS Learning team"
  ],
  "files": [
    "addon-main.cjs",
    "dist",
    "src",
    "public"
  ],
  "imports": {
    "#demo-app/*": "./app/*",
    "#src/*": "./src/*"
  },
  "exports": {
    ".": "./dist/index.js",
    "./*": "./dist/*.js",
    "./*.css": "./dist/*.css",
    "./addon-main": "./addon-main.cjs"
  },
  "scripts": {
    "build": "vite build",
    "build:styleguide": "rollup --config && postcss src/styles/addon.css -o dist/styles.css --no-map",
    "start": "vite dev",
    "lint": "concurrently \"pnpm:lint:*(!fix)\" --names \"lint:\" --prefixColors auto",
    "lint:css": "stylelint \"**/*.css\"",
    "lint:css:fix": "concurrently \"pnpm:lint:css -- --fix\"",
    "lint:fix": "concurrently \"pnpm:lint:*:fix\" --names \"fix:\" --prefixColors auto && pnpm format",
    "lint:format": "prettier . --cache --check",
    "lint:hbs": "ember-template-lint . --no-error-on-unmatched-pattern",
    "lint:hbs:fix": "ember-template-lint . --fix --no-error-on-unmatched-pattern",
    "lint:js": "eslint . --cache",
    "lint:js:fix": "eslint . --fix",
    "format": "prettier . --cache --write",
    "test": "vite build --mode=development --out-dir dist-tests && testem --file testem.cjs ci --port 0",
    "prepack": "pnpm build:styleguide"
  },
  "dependencies": {
    "@ember/test-waiters": "^4.1.1",
    "@embroider/addon-shim": "^1.8.9",
    "@embroider/legacy-inspector-support": "^0.1.3",
    "@glimmer/component": "2.0.0",
    "@shikijs/rehype": "^4.0.2",
    "decorator-transforms": "^2.3.0",
    "ember-concurrency": "^5.0.0",
    "ember-modifier": "^4.3.0",
    "ember-primitives": "^0.55.0",
    "ember-repl": "^8.0.2",
    "kolay": "^5.1.4"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/eslint-parser": "^7.25.1",
    "@babel/plugin-proposal-decorators": "^7.24.7",
    "@babel/runtime": "^7.25.6",
    "@ember/test-helpers": "^5.2.1",
    "@embroider/addon-dev": "^8.3.0",
    "@embroider/core": "^4.1.0",
    "@embroider/macros": "^1.20.1",
    "@embroider/vite": "^1.1.5",
    "@eslint/js": "^9.37.0",
    "@percy/cli": "^1.27.7",
    "@percy/ember": "^5.0.0",
    "@rollup/plugin-babel": "^7.0.0",
    "babel-plugin-ember-template-compilation": "^4.0.0",
    "concurrently": "^9.2.1",
    "ember-page-title": "^9.0.3",
    "ember-qunit": "^9.0.2",
    "ember-source": "6.12.0-beta.3",
    "ember-strict-application-resolver": "^0.1.0",
    "ember-template-lint": "^7.7.0",
    "eslint": "^9.37.0",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-ember": "^12.7.4",
    "eslint-plugin-n": "^17.23.1",
    "eslint-plugin-qunit": "^8.2.5",
    "globals": "^15.15.0",
    "normalize.css": "^8.0.1",
    "postcss": "^8.4.47",
    "postcss-cli": "^11.0.0",
    "postcss-import": "^16.1.0",
    "postcss-preset-env": "^10.0.0",
    "prettier": "^3.6.2",
    "prettier-plugin-ember-template-tag": "^2.1.0",
    "qunit": "^2.22.0",
    "qunit-dom": "^3.2.1",
    "release-plan": "^0.17.4",
    "rollup": "^4.24.0",
    "shiki": "^4.0.2",
    "sinon": "^19.0.0",
    "stylelint": "^16.25.0",
    "stylelint-config-standard": "^36.0.1",
    "stylelint-declaration-strict-value": "^1.8.0",
    "stylelint-order": "^4.0.0",
    "testem": "^3.15.1",
    "vite": "^8.0.3"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">= 24"
  },
  "volta": {
    "node": "^24"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "ember": {
    "edition": "octane"
  },
  "ember-addon": {
    "version": 2,
    "type": "addon",
    "main": "addon-main.cjs",
    "public-assets": {
      "./public/ember-logo.png": "/ember-logo.png",
      "./public/emberconf.jpg": "/emberconf.jpg",
      "./public/fonts/Inter-ExtraLight.woff": "/fonts/Inter-ExtraLight.woff",
      "./public/fonts/Inter-ExtraLight.woff2": "/fonts/Inter-ExtraLight.woff2",
      "./public/fonts/Inter-Italic.woff": "/fonts/Inter-Italic.woff",
      "./public/fonts/Inter-Italic.woff2": "/fonts/Inter-Italic.woff2",
      "./public/fonts/Inter-Regular.woff": "/fonts/Inter-Regular.woff",
      "./public/fonts/Inter-Regular.woff2": "/fonts/Inter-Regular.woff2",
      "./public/fonts/Inter-SemiBold.woff": "/fonts/Inter-SemiBold.woff",
      "./public/fonts/Inter-SemiBold.woff2": "/fonts/Inter-SemiBold.woff2",
      "./public/fonts/Inter-SemiBoldItalic.woff": "/fonts/Inter-SemiBoldItalic.woff",
      "./public/fonts/Inter-SemiBoldItalic.woff2": "/fonts/Inter-SemiBoldItalic.woff2",
      "./public/fonts/Inter-roman.var.woff2": "/fonts/Inter-roman.var.woff2",
      "./public/images/arrow-icon.svg": "/images/arrow-icon.svg",
      "./public/images/boxes-bottom-continued.svg": "/images/boxes-bottom-continued.svg",
      "./public/images/boxes-bottom-light.svg": "/images/boxes-bottom-light.svg",
      "./public/images/boxes-bottom.svg": "/images/boxes-bottom.svg",
      "./public/images/boxes-top.svg": "/images/boxes-top.svg",
      "./public/images/ember-logo-white.svg": "/images/ember-logo-white.svg",
      "./public/images/ember-logo.svg": "/images/ember-logo.svg",
      "./public/images/mascots/tomster.png": "/images/mascots/tomster.png",
      "./public/images/mascots/zoey.png": "/images/mascots/zoey.png",
      "./public/images/quotes.svg": "/images/quotes.svg",
      "./public/images/swipe-bottom.svg": "/images/swipe-bottom.svg",
      "./public/images/swipe-top.svg": "/images/swipe-top.svg"
    },
    "app-js": {
      "./components/es-banner.js": "./dist/_app_/components/es-banner.js",
      "./components/es-button.js": "./dist/_app_/components/es-button.js",
      "./components/es-card-content.js": "./dist/_app_/components/es-card-content.js",
      "./components/es-card.js": "./dist/_app_/components/es-card.js",
      "./components/es-footer-contributions.js": "./dist/_app_/components/es-footer-contributions.js",
      "./components/es-footer-help.js": "./dist/_app_/components/es-footer-help.js",
      "./components/es-footer-info.js": "./dist/_app_/components/es-footer-info.js",
      "./components/es-footer-statement.js": "./dist/_app_/components/es-footer-statement.js",
      "./components/es-footer.js": "./dist/_app_/components/es-footer.js",
      "./components/es-header-navbar-link.js": "./dist/_app_/components/es-header-navbar-link.js",
      "./components/es-header.js": "./dist/_app_/components/es-header.js",
      "./components/es-icon.js": "./dist/_app_/components/es-icon.js",
      "./components/es-link-card.js": "./dist/_app_/components/es-link-card.js",
      "./components/es-note.js": "./dist/_app_/components/es-note.js",
      "./components/es-pagination.js": "./dist/_app_/components/es-pagination.js",
      "./components/es-progress-bar.js": "./dist/_app_/components/es-progress-bar.js",
      "./components/es-sidebar.js": "./dist/_app_/components/es-sidebar.js",
      "./services/navbar.js": "./dist/_app_/services/navbar.js",
      "./services/progress.js": "./dist/_app_/services/progress.js"
    }
  },
  "pnpm": {
    "overrides": {
      "@glimmer/component": "$@glimmer/component"
    }
  }
}
